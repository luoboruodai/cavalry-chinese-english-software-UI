{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "Cavalry Bilingual",
  "version": "0.1.5",
  "identifier": "com.cavalry-bilingual.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:resources && npm run build",
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cavalry Bilingual",
        "width": 1000,
        "height": 760,
        "minWidth": 700,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "hiddenTitle": true,
        "backgroundColor": "#f5f1e4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost https://api.emailjs.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": []
  }
}
